@MBVM:cli-master-rules:3.6.0%rules=22%clis=all%tokensave=99%%lang=go1.27+rust%mode=solo%engine=mbvm-db
^R0:mbvm_canonical!mbvm_db_engine!smart_slicing_first!immutable_binary_db_first!query[mbvm-db slice <db> <symbol/term> <depth>]!no_raw_heavy_reads!dual_storage
~Storage{canonical="codebase.mbvm"!databases="*.mbvmdb"!engine="mbvm-db"!source="."!cache="page_bytecodes.db"!traceability=crc32}
