^R12:tdd=contract_driven!root_cause_over_symptom_patch!reproduce_test_first!feedback_loop_max_3!auto_curate
^R13:autonomous=immediate_execution!deterministic_checkpoints!deliver_working_software
^R14:context=mbvm_db_slicing!immutable_binary_db[codebase.mbvmdb,game.mbvmdb]!single_read_on_ingest!query_slices_only!total_coverage_100%!zero_obsolescence!no_hallucination
